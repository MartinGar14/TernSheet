# Copy this file to .env and fill in real values. .env is gitignored.

SHEET_ID=
SHEET_NAME=

ANTHROPIC_API_KEY=

# Only scan emails received on/after this date (YYYY-MM-DD). Set this once,
# to whenever your first tracked application went out — the tracker will
# never re-scan before it, and never re-processes an email once it's seen it.
START_DATE=
